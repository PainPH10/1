-- Hàm kiểm tra đường đi bằng Raycast
local function isPathBlocked(targetPos)
	local origin = humanoidRootPart.Position + Vector3.new(0, 2, 0)
	local direction = targetPos - origin
	
	local raycastParams = RaycastParams.new()
	raycastParams.FilterType = Enum.RaycastFilterType.Exclude
	raycastParams.FilterDescendantsInstances = {character}
	raycastParams.IgnoreWater = true
	
	local result = workspace:Raycast(origin, direction, raycastParams)
	if result then
		if (result.Position - targetPos).Magnitude > 5 then
			return true 
		end
	end
	return false
end

-- Hàm tìm kiếm vật phẩm thông minh
local function findSmartItem()
	local nearestPart = nil
	local shortestDistance = math.huge
	
	if not humanoidRootPart then return nil end
	local currentPos = humanoidRootPart.Position
	
	for _, obj in ipairs(workspace:GetDescendants()) do
		local targetPart = nil
		if obj:IsA("BasePart") then
			targetPart = obj
		elseif obj:IsA("Model") then
			targetPart = obj.PrimaryPart or obj:FindFirstChildWhichIsA("BasePart")
		end
		
		if targetPart then
			local partPos = targetPart.Position
			if math.abs(partPos.Y - fixedY) <= yTolerance or math.abs(partPos.Y - currentPos.Y) <= yTolerance then
				local nameLower = string.lower(targetPart.Name)
				local parentNameLower = string.lower(targetPart.Parent.Name)
				
				local isItem = string.find(nameLower, "berry") or 
				                string.find(nameLower, "food") or 
				                string.find(nameLower, "fruit") or
				                string.find(parentNameLower, "berry") or
				                string.find(parentNameLower, "food") or
				                string.find(nameLower, "xp")
								
				local isIgnored = string.find(nameLower, "spawn") or string.find(nameLower, "baseplate")
				
				if isItem and not isIgnored then
					local distance = (currentPos - partPos).Magnitude
					if distance <= maxSearchDistance and not character:IsAncestorOf(targetPart) then
						if not isPathBlocked(partPos) then
							if distance < shortestDistance then
								shortestDistance = distance
								nearestPart = targetPart
							end
						end
					end
				end
			end
		end
	end
	return nearestPart
end

-- Vòng lặp di chuyển mượt
RunService.Heartbeat:Connect(function(dt)
	if not autoFarmActive then return end
	
	character = player.Character
	if not character or not character:FindFirstChild("Humanoid") or not character:FindFirstChild("HumanoidRootPart") then return end
	
	humanoid = character.Humanoid
	humanoidRootPart = character.HumanoidRootPart
	
	humanoid.PlatformStand = true 
	
	local currentPos = humanoidRootPart.Position
	local targetItem = findSmartItem()
	local targetPos = nil
	
	if targetItem and targetItem.Parent then
		targetPos = Vector3.new(targetItem.Position.X, fixedY, targetItem.Position.Z)
		lastWanderTime = tick()
	else
		if tick() - lastWanderTime > 3 then
			lastWanderTime = tick()
			local randomX = currentPos.X + math.random(-70, 70)
			local randomZ = currentPos.Z + math.random(-70, 70)
			wanderTarget = Vector3.new(randomX, fixedY, randomZ)
		end
		if wanderTarget then
			targetPos = wanderTarget
		end
	end
	
	if targetPos then
		local goalPos = Vector3.new(targetPos.X, fixedY, targetPos.Z)
		local direction = (goalPos - currentPos)
		local distance = direction.Magnitude
		
		if distance > 1 then
			direction = direction.Unit
			local targetVel = direction * normalSpeed
			currentVelocity = currentVelocity:Lerp(targetVel, math.clamp(dt * 10, 0, 1))
			
			local newPos = currentPos + currentVelocity * dt
			humanoidRootPart.CFrame = CFrame.new(newPos.X, fixedY, newPos.Z) * CFrame.Angles(0, math.atan2(-direction.X, -direction.Z), 0)
			humanoidRootPart.AssemblyLinearVelocity = Vector3.zero
		else
			currentVelocity = Vector3.new(0, 0, 0)
			humanoidRootPart.AssemblyLinearVelocity = Vector3.zero
		end
	end
end)
