                        if travelTime < 0.05 then travelTime = 0.05 end

                        local tweenInfo = TweenInfo.new(travelTime, Enum.EasingStyle.Linear)
                        local tween = TweenService:Create(hrpFarm, tweenInfo, {CFrame = targetCFrame})
                        
                        tween:Play()
                        task.wait(travelTime)

                        pcall(function()
                            if bestFood:IsA("BasePart") then
                                firetouchinterest(hrpFarm, bestFood, 0)
                                task.wait(0.03)
                                firetouchinterest(hrpFarm, bestFood, 1)
                            elseif bestFood:IsA("Model") and bestFood.PrimaryPart then
                                firetouchinterest(hrpFarm, bestFood.PrimaryPart, 0)
