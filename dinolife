                            end)

                            if pos and isVisible and math.abs(pos.Y - TARGET_Y_LAND) <= Y_TOLERANCE_LAND then
                                local dist = (hrpFarm.Position - pos).Magnitude
                                if dist < shortestDist then
                                    shortestDist = dist
                                    bestFood = food
                                end
                            end
                        end
                    end
