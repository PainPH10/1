    local c = LocalPlayer.Character
    if not c then return nil end
    return c:FindFirstChild("HumanoidRootPart") or c.PrimaryPart
end

local TARGET_Y_LAND = 11.36
local Y_TOLERANCE_LAND = 4
local autoFarmSpeed = 40

task.spawn(function()
    local visitedOrbsLand = {}

    while task.wait(0.1) do
        if autoFarmLand and LocalPlayer.Character then
            local hrpFarm = getHRP_AutoFarm()
            local humanoid = LocalPlayer.Character:FindFirstChildOfClass("Humanoid")

            if hrpFarm and humanoid then
                local bestFood = nil
                local shortestDist = math.huge

                for _, food in pairs(workspace:GetDescendants()) do
                    if food and food.Parent and not visitedOrbsLand[food] then
                        local nameLower = string.lower(food.Name)
                        if string.find(nameLower, "food") or string.find(nameLower, "orb") or string.find(nameLower, "meat") or string.find(nameLower, "hp") then
                            local pos = nil
                            local isVisible = true
                            pcall(function()
                                if food:IsA("Model") then
