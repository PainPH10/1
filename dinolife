-- ==================== LOGIC SERVER HOP ====================
local function ServerHop()
    local placeId = game.PlaceId
    local jobId = game.JobId
    
    local req = request or http_request or (syn and syn.request) or (http and http.request)
    if req then
        local api = "https://games.roblox.com/v1/games/" .. placeId .. "/servers/0?sortOrder=Asc&limit=100"
        local success, response = pcall(function()
            return req({Url = api, Method = "GET"})
        end)
        
        if success and response and response.Body then
            local data = HttpService:JSONDecode(response.Body)
            if data and data.data then
                local targetServer = nil
                local minPlayers = math.huge
                
                for _, v in ipairs(data.data) do
                    if type(v) == "table" and v.id ~= jobId and v.playing < v.maxPlayers then
                        if v.playing < minPlayers then
                            minPlayers = v.playing
                            targetServer = v.id
                        end
                    end
                end
                
                if targetServer then
                    TeleportService:TeleportToPlaceInstance(placeId, targetServer, LocalPlayer)
                    return
                end
            end
        end
    end
    
    TeleportService:Teleport(placeId, LocalPlayer)
end

