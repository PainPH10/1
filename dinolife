    billboard.Parent = espFolder
    
    RunService.RenderStepped:Connect(function()
        local isAnyEspActive = espNameEnabled or espHealthEnabled or espDistanceEnabled
        if not isAnyEspActive then
            billboard.Enabled = false
            return
        end

        local c = otherPlayer.Character
        local myChar = LocalPlayer.Character
        local myHrp = myChar and (myChar:FindFirstChild("HumanoidRootPart") or myChar.PrimaryPart)

