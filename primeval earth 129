local function createMenuButton(name, text, order)
	local btn = Instance.new("TextButton")
	btn.Name = name
	btn.BackgroundColor3 = Color3.fromRGB(18, 18, 18)
	btn.BackgroundTransparency = 0.35
	btn.TextColor3 = Color3.fromRGB(235, 235, 235)
	btn.Text = text
	btn.TextSize = 13
	btn.Font = Enum.Font.GothamMedium
	btn.AutoButtonColor = false
	btn.LayoutOrder = order
	btn.Parent = containerHolder

	local corner = Instance.new("UICorner")
	corner.CornerRadius = UDim.new(0, 8)
	corner.Parent = btn

	local stroke = Instance.new("UIStroke")
	stroke.Color = Color3.fromRGB(60, 20, 20)
	stroke.Transparency = 0.4
	stroke.Thickness = 1
	stroke.Parent = btn
	
	btn.MouseEnter:Connect(function()
		TweenService:Create(btn, TweenInfo.new(0.2), {BackgroundColor3 = Color3.fromRGB(30, 20, 20), BackgroundTransparency = 0.15}):Play()
		TweenService:Create(stroke, TweenInfo.new(0.2), {Color = Color3.fromRGB(150, 0, 0), Transparency = 0}):Play()
	end)
	btn.MouseLeave:Connect(function()
		if not btn:GetAttribute("ActiveState") then
			TweenService:Create(btn, TweenInfo.new(0.2), {BackgroundColor3 = Color3.fromRGB(18, 18, 18), BackgroundTransparency = 0.35}):Play()
			TweenService:Create(stroke, TweenInfo.new(0.2), {Color = Color3.fromRGB(60, 20, 20), Transparency = 0.4}):Play()
		end
	end)
	
	return btn
end

