									local p = tree:IsA("BasePart") and tree or tree:FindFirstChildWhichIsA("BasePart")
									if p and (hrpTarget.Position - p.Position).Magnitude < shortest then
										shortest = (hrpTarget.Position - p.Position).Magnitude
										closest = tree
									end
								end
							end
						end
					end
					if closest then remote:FireServer(closest) end
				end
			end)
			task.wait(0.4)
		else
			task.wait(0.2)
		end
	end
end)

