local function getClosestTarget()
	if selectedAimTarget and selectedAimTarget.Parent == Players then
		local charTarget = selectedAimTarget.Character
		if charTarget and charTarget:FindFirstChild("Humanoid") and charTarget.Humanoid.Health > 0 and charTarget:FindFirstChild("HumanoidRootPart") then
			return selectedAimTarget
		else
			selectedAimTarget = nil
			aimDistBtn.Text = "Dist: " .. targetDistance
		end
	end

	local closest = nil
	local shortest = math.huge
	local myChar = player.Character
	if not myChar or not myChar:FindFirstChild("HumanoidRootPart") then return nil end
	local myPos = myChar.HumanoidRootPart.Position
	
	for _, p in ipairs(Players:GetPlayers()) do
		if p ~= player and p.Character and p.Character:FindFirstChild("Humanoid") and p.Character:FindFirstChild("HumanoidRootPart") then
			if p.Character.Humanoid.Health > 0 then
				local dist = (p.Character.HumanoidRootPart.Position - myPos).Magnitude
				if dist <= targetDistance and dist < shortest then
					shortest = dist
					closest = p
				end
			end
		end
	end
	return closest
end

