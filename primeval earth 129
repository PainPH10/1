local function startFly()
	flyEnabled = true
	flyButton:SetAttribute("ActiveState", true)
	if not hrp then return end
	att = Instance.new("Attachment", hrp)
	
	lv = Instance.new("LinearVelocity")
	lv.Attachment0 = att
	lv.MaxForce = math.huge
	lv.VectorVelocity = Vector3.new(0, 0, 0)
	lv.Parent = hrp
	
	ag = Instance.new("AlignOrientation")
	ag.Attachment0 = att
	ag.MaxTorque = math.huge
	ag.Responsiveness = 200
	ag.Parent = hrp
	
	flyButton.Text = "Fly: " .. flySpeed .. " [ BẬT ]"
	TweenService:Create(flyButton, TweenInfo.new(0.2), {BackgroundColor3 = Color3.fromRGB(120, 0, 0), BackgroundTransparency = 0.2}):Play()
	TweenService:Create(fBtnStroke, TweenInfo.new(0.2), {Color = Color3.fromRGB(255, 0, 0), Transparency = 0}):Play()
end

local function stopFly()
	flyEnabled = false
	flyButton:SetAttribute("ActiveState", false)
	if lv then lv:Destroy() end
	if ag then ag:Destroy() end
	if att then att:Destroy() end
	flyButton.Text = "Fly: " .. flySpeed .. " [ TẮT ]"
	TweenService:Create(flyButton, TweenInfo.new(0.2), {BackgroundColor3 = Color3.fromRGB(18, 18, 18), BackgroundTransparency = 0.35}):Play()
	TweenService:Create(fBtnStroke, TweenInfo.new(0.2), {Color = Color3.fromRGB(60, 20, 20), Transparency = 0.4}):Play()
end

flyButton.MouseButton1Click:Connect(function()
	if flyEnabled then stopFly() else startFly() end
end)

btnFlyMinus.MouseButton1Click:Connect(function()
