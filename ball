local function cleanupESP()
    for _, obj in pairs(Workspace:GetDescendants()) do
        if obj:FindFirstChild("BallESP_Gui") then obj.BallESP_Gui:Destroy() end
        if obj:FindFirstChild("Ball_Att") then obj.Ball_Att:Destroy() end
    end
    local char = player.Character
    if char and char:FindFirstChild("HumanoidRootPart") then
        local root = char.HumanoidRootPart
        if root:FindFirstChild("Player_Att") then root.Player_Att:Destroy() end
        if root:FindFirstChild("Ball_Beam") then root.Ball_Beam:Destroy() end
    end
end

ESPButton.MouseButton1Click:Connect(function()
    espEnabled = not espEnabled
    ESPButton.Text = espEnabled and "Ball ESP: ON" or "Ball ESP: OFF"
    ESPButton.BackgroundColor3 = espEnabled and Color3.fromRGB(50, 220, 50) or Color3.fromRGB(220, 50, 50)
    if not espEnabled then cleanupESP() end
end)

-- ========================================================
-- 5. VÒNG LẶP XỬ LÝ NO SLOWDOWN & ESP
-- ========================================================

RunService.PreRender:Connect(function()
    local character = player.Character
    if not character then return end

    local humanoid = character:FindFirstChildOfClass("Humanoid")
    local rootPart = character:FindFirstChild("HumanoidRootPart")
    local ballPart = getBall()

    if not humanoid or not rootPart or humanoid.Health <= 0 then return end

    -- 1. CHỐNG KHỰNG / CHẬM KHI SÚT BÓNG
    if noSlowdownEnabled then
        if humanoid.WalkSpeed < 16 then
            humanoid.WalkSpeed = 16
        end

        humanoid.AutoRotate = true
        humanoid.PlatformStand = false

        -- Tăng tốc Animation sút để không trễ đà
        local animator = humanoid:FindFirstChildOfClass("Animator")
        if animator then
            for _, track in pairs(animator:GetPlayingAnimationTracks()) do
                local n = string.lower(track.Name)
                if string.find(n, "shoot") or string.find(n, "kick") or string.find(n, "sut") then
                    track:AdjustSpeed(2.5)
                elseif string.find(n, "slow") or string.find(n, "stun") or string.find(n, "tackle") then
                    track:Stop()
                end
            end
        end

        -- Clear biến trạng thái làm chậm trong nhân vật
        for _, child in pairs(character:GetDescendants()) do
            if child:IsA("ValueBase") then
                local n = string.lower(child.Name)
                if string.find(n, "shoot") or string.find(n, "kick") or string.find(n, "slow") or string.find(n, "kickslow") then
                    if child:IsA("BoolValue") then 
                        child.Value = false 
                    elseif child:IsA("NumberValue") or child:IsA("IntValue") then 
                        child.Value = 0 
                    end
                end
            end
        end
    end

    -- 2. BALL ESP & BEAM
    if espEnabled and ballPart then
        local playerAtt = rootPart:FindFirstChild("Player_Att") or Instance.new("Attachment", rootPart)
        playerAtt.Name = "Player_Att"

        local ballAtt = ballPart:FindFirstChild("Ball_Att") or Instance.new("Attachment", ballPart)
        ballAtt.Name = "Ball_Att"

        local beam = rootPart:FindFirstChild("Ball_Beam")
        if not beam then
            beam = Instance.new("Beam")
            beam.Name = "Ball_Beam"
            beam.Width0 = 0.25
            beam.Width1 = 0.25
            beam.Color = ColorSequence.new(Color3.fromRGB(255, 230, 0))
            beam.FaceCamera = true
            beam.LightEmission = 1
            beam.LightInfluence = 0
            beam.Attachment0 = playerAtt
            beam.Attachment1 = ballAtt
            beam.Parent = rootPart
        else
            beam.Attachment0 = playerAtt
            beam.Attachment1 = ballAtt
            beam.Enabled = true
        end

        if not ballPart:FindFirstChild("BallESP_Gui") then
            local billboard = Instance.new("BillboardGui")
            billboard.Name = "BallESP_Gui"
            billboard.AlwaysOnTop = true
            billboard.Size = UDim2.new(0, 100, 0, 30)
            billboard.StudsOffset = Vector3.new(0, 2.5, 0)
            billboard.Adornee = ballPart
            billboard.Parent = ballPart

            local label = Instance.new("TextLabel", billboard)
            label.Size = UDim2.new(1, 0, 1, 0)
            label.BackgroundTransparency = 1
            label.Text = "⚽ BALL"
            label.TextColor3 = Color3.fromRGB(255, 230, 0)
            label.TextStrokeTransparency = 0
            label.Font = Enum.Font.GothamBold
            label.TextSize = 15
        end
    elseif rootPart and rootPart:FindFirstChild("Ball_Beam") then
        rootPart.Ball_Beam.Enabled = false
    end
end)
