-- ========================================================
-- 2. HOOK CHẶN GAME HẠ WALKSPEED KHI SÚT
-- ========================================================

local rawmeta = getrawmetatable or getmetatable
if rawmeta and setreadonly then
    local mt = rawmeta(game)
    setreadonly(mt, false)
    local oldNewIndex = mt.__newindex

    mt.__newindex = newcclosure(function(t, k, v)
        if noSlowdownEnabled and not checkcaller() and typeof(t) == "Instance" and t:IsA("Humanoid") then
            if k == "WalkSpeed" or k == "walkSpeed" then
                if type(v) == "number" and v < 16 then
                    v = 16 -- Ép giữ nguyên tốc độ chạy lúc sút
                end
            end
        end
        return oldNewIndex(t, k, v)
    end)
    setreadonly(mt, true)
end

-- ========================================================
-- 3. HÀM TÌM BÓNG
-- ========================================================

local function getBall()
    for _, obj in pairs(Workspace:GetDescendants()) do
        local isPlayerPart = false
        for _, p in pairs(Players:GetPlayers()) do
            if p.Character and obj:IsDescendantOf(p.Character) then
                isPlayerPart = true
                break
            end
        end

        if not isPlayerPart then
            if obj:IsA("BasePart") then
                local nameLower = string.lower(obj.Name)
                if string.find(nameLower, "ball") or string.find(nameLower, "soccer") 
                   or string.find(nameLower, "football") or string.find(nameLower, "pelota") 
                   or string.find(nameLower, "tps") or obj.Shape == Enum.PartType.Ball then
                    return obj
                end
            elseif obj:IsA("Model") then
                local nameLower = string.lower(obj.Name)
                if string.find(nameLower, "ball") or string.find(nameLower, "soccer") or string.find(nameLower, "football") then
                    local part = obj.PrimaryPart or obj:FindFirstChildWhichIsA("BasePart")
                    if part then return part end
                end
            end
        end
    end
    return nil
end

